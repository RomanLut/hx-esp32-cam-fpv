CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y

CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_CAMERA_MODULE_ESP_S3_EYE=y
CONFIG_LCD_DRIVER_SCREEN_CONTROLLER_ST7789=y
CONFIG_ESPTOOLPY_NO_STUB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_SPIRAM_MODE_OCT=y

#internal RAM budget: single wifi client only, air unit is almost pure TX.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=3

#cache TX queue is only used when static TX buffer alloc fails, i.e. exactly when
#internal RAM is already short - keep it small so it cannot amplify the shortage
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4

#NOT reduced: esp_http_server rejects max_open_sockets > LWIP_MAX_SOCKETS-3, and
#the file server uses HTTPD_DEFAULT_CONFIG() (max_open_sockets=7), so 10 is the
#minimum that lets httpd_start() succeed. Saving would have been ~240 bytes anyway.
CONFIG_LWIP_MAX_SOCKETS=10

#move non-DMA wifi/lwip buffers to PSRAM. Does not affect the WLAN outgoing queue
#or the FEC pools, both allocated explicitly with MALLOC_CAP_INTERNAL.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

#adds ~8kb RAM
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

#can free ~6kb
#CONFIG_ESP_WIFI_IRAM_OPT=n

CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_DEVICE_ENABLED=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_USB_OTG_SUPPORTED=y
