diff --git a/hal/rtl8812a/rtl8812a_hal_init.c b/hal/rtl8812a/rtl8812a_hal_init.c
index a19546f..d80da6d 100644
--- a/hal/rtl8812a/rtl8812a_hal_init.c
+++ b/hal/rtl8812a/rtl8812a_hal_init.c
@@ -4259,19 +4259,20 @@ static void hw_var_set_opmode(PADAPTER Adapter, u8 variable, u8 *val)
 {
 	u8	val8;
 	u8	mode = *((u8 *)val);
-	static u8 isMonitor = _FALSE;
 
 	HAL_DATA_TYPE			*pHalData = GET_HAL_DATA(Adapter);
 
-	if (isMonitor == _TRUE) {
+	/* Monitor state is adapter-local. A module-global flag restores another
+	 * adapter's uninitialized RCR backup when two radios enter monitor mode. */
+	if (pHalData->monitor_mode_active == _TRUE) {
 		/* reset RCR from backup */
 		rtw_hal_set_hwreg(Adapter, HW_VAR_RCR, (u8 *)&pHalData->rcr_backup);
 		rtw_hal_rcr_set_chk_bssid(Adapter, MLME_ACTION_NONE);
-		isMonitor = _FALSE;
+		pHalData->monitor_mode_active = _FALSE;
 	}
 
 	if (mode == _HW_STATE_MONITOR_) {
-		isMonitor = _TRUE;
+		pHalData->monitor_mode_active = _TRUE;
 		/* set net_type */
 		Set_MSR(Adapter, _HW_STATE_NOLINK_);
 
